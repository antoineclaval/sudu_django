[flake8]
exclude =
    .venv,
    migrations,
    __pycache__
ignore =
    E501,
    F401,
    W291,
    W292,
    W293,
    E122,
    E124,
    E128,
    E131,
    E201,
    E203,
    E221,
    E222,
    E226,
    E231,
    E251,
    E261,
    E262,
    E265,
    E275,
    E301,
    E302,
    E303,
    E305,
    E741
