FROM python:3.13-alpine

WORKDIR /home/app/web

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install UV
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Install system dependencies for psycopg, Pillow, lxml
RUN apk update \
    && apk add --virtual build-deps gcc python3-dev musl-dev libc-dev libxslt-dev \
    && apk add postgresql-dev jpeg-dev zlib-dev libjpeg libxslt libpq

# Lint
RUN uv pip install --system flake8
COPY . .
RUN flake8 .

# Install dependencies
COPY ./pyproject.toml .
RUN uv pip install --system -r pyproject.toml

# Clean up build deps
RUN apk del build-deps

# Create app user and directories
RUN addgroup -S app && adduser -S app -G app \
    && mkdir -p staticfiles mediafiles \
    && chown -R app:app /home/app/web

USER app

ENTRYPOINT ["/home/app/web/entrypoint.prod.sh"]
